@{
    ViewData["Title"] = "Section List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Teacher List-->
<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800">Section List</h1>
<!-- <p class="mb-4">Table for Teachers Info</p> -->
<!-- DataTales Example -->
<div class="card shadow mb-4" style="margin-top: 20px;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">Table for Section's Info</h6>
        <button type="button" class="btn btn-success bg-gradient-success btn-icon-split" data-bs-toggle="modal" data-bs-target="#AddSmallModalForm" data-url="/Admin/AddSection" data-title="Add Section Details">
            <span class="text">Add Section</span>
        </button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th><strong>#</strong></th>
                        <th><strong>Grade Level</strong></th>
                        <th><strong>Section Name</strong></th>
                        <th><strong>Category/Track</strong></th>
                        <th><strong>Action</strong></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach (var Section in Model)
                    {
                        <tr>
                            <td><strong>@(i++)</strong></td>
                            <td><strong>Grade @Section.Grade.GradeLevel</strong></td>
                            <td><strong>@Section.SectionName</strong></td>
                            @* <td><strong>@Section.Grade.Category - @Section.Track</strong></td> *@
                            <td>
                                <strong>
                                    @if(Section.Grade.Category == "Junior High School(JHS)")
                                    {
                                        @Section.Grade.Category
                                    }else if (Section.Track == "TVL")
                                    {
                                        @($"{Section.Grade.Category} - {Section.Track} - {Section.TVLProgram} ")
                                    }
                                    else
                                    {
                                        @($"{Section.Grade.Category} - {Section.Track} ")
                                    }
                                </strong>
                            </td>

                            <td class="text-center">
                                @* <a asp-controller="SectionList" asp-action="ManageSectionSubject" asp-route-id="@Section.Id" title="Manage Assign Subjects">
                                    <i class="fa fa-tasks"></i>
                                </a> *@
                                <a asp-action="ManageSectionSubject" asp-route-id="@Section.Id" class="btn btn-primary btn-circle" title="Manage Assign Subjects">
                                    <i class="fa fa-tasks"></i>
                                </a>
                                <button title="Edit Section" data-id="@Section.Id" type="button" class="btn btn-primary btn-circle" data-bs-toggle="modal" data-bs-target="#EditSmallModal" data-url="/Admin/EditSection/" data-title="Edit Section Detail's">
                                    <i class="fas fa-edit"></i>@*Edit*@
                                </button>
                                <button title="Delete Section" data-id="@Section.Id" type="button" class="btn btn-danger btn-circle" data-bs-toggle="modal" data-bs-target="#ModalDelete">
                                    <i class="fas fa-trash"></i>@*Delete*@
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/admin-section.js"></script>
    @* <script src="~/js/admin-assignSubject.js"></script> *@
}

