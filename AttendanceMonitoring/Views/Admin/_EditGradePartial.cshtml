@using AttendanceMonitoring.ViewModel;
@model GradeViewModel;
@{
    ViewData["Title"] = "Edit Grade";
}
<style>
    input::placeholder {
        font-style: italic;
    }

    .form-group {
        color: black;
    }
</style>
<form id="EditGradeForm" asp-action="EditGrade" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    </div>
    <div class="form-group">
        <label asp-for="GradeLevel" class="form-label"><strong>Grade Level</strong></label>
        <select asp-for="GradeLevel" class="form-control" required>
            <option value="" selected>Choose...</option>
            <option value="7">Grade 7</option>
            <option value="8">Grade 8</option>
            <option value="9">Grade 9</option>
            <option value="10">Grade 10</option>
            <option value="11">Grade 11</option>
            <option value="12">Grade 12</option>

        </select>
        <span asp-validation-for="GradeLevel" class="text-danger validation-error-message"></span>
    </div>
    <div class="form-group">
        <label asp-for="Category" class="form-label"><strong>Category</strong></label>
        <select asp-for="Category" class="form-control" required>
            <option value="" selected>Choose...</option>
            <option value="Junior High School(JHS)">Junior High School(JHS)</option>
            <option value="Senior High School(SHS)">Senior High School(SHS)</option>
        </select>
        <span asp-validation-for="Category" class="text-danger validation-error-message"></span>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary" id="SaveGradeAndSection">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
@section Script {
    @{

        await Html.RenderPartialAsync("_ValidationScriptPartial.cshtml");
    }
}