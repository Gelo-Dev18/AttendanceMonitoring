@* @using AttendanceMonitoring.Models; *@
@using System.Linq
@model IEnumerable<AttendanceMonitoring.Models.Student>
@{
    ViewData["Title"] = "Restore Student's Assignment";
}
<div class="card shadow mb-2" style="margin-top: 20px;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">Table for Student Assignment's History</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable2" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th><strong>#</strong></th>
                        <th><strong>Student Name</strong></th>
                        <th><strong>Grade & Section</strong></th>
                        <th><strong>Action</strong></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var c = 1;
                    }
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var student in Model)
                        {
                            var assignment = student.SectionAssignments?.FirstOrDefault();      
                            
                            <tr>
                                <td><strong>@(c++)</strong></td>
                                <td><strong>@student.FirstName @student.MiddelName @student.LastName</strong></td>

                                <td>
                                    <strong>
                                        @if(assignment != null)
                                        {
                                            <text>
                                                Grade @assignment.Section?.Grade?.GradeLevel
                                                @assignment.Section?.SectionName
                                                @assignment.Section?.Track
                                                @assignment.Section?.TVLProgram
                                            </text>
                                        }
                                        else
                                        {
                                            <text>
                                                No class assigned!
                                            </text>
                                        }

                                    </strong>
                                </td>
                                <td class="text-center">
                                    <strong>
                                        <button data-student-id="@student.Id" type="button" class="btn btn-warning btn-circle restore-btn" title="Restore Student Assignment Details">
                                            <i class="fas fa-trash-restore"></i>
                                        </button>
                                        <button class="btn btn-danger btn-circle remove-btn" data-student-id="@student.Id" type="button">

                                            <i class="fas fa-trash"></i>@*Delete*@
                                        </button>
                                    </strong>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Script {
    @{

        await Html.RenderPartialAsync("_ValidationScriptPartial.cshtml");
    }
}