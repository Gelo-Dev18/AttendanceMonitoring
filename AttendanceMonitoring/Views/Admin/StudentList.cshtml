<div class="card shadow mb-4" style="margin-top: 20px;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">Table for Student's Info</h6>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success bg-gradient-success btn-icon-split mr-1" data-bs-toggle="modal" data-bs-target="#AddModalForm" data-url="/Admin/AddStudent" data-title="Add Student's Details">
                <span class="text">Add Student</span>
            </button>
            <button type="button" class="btn btn-warning bg-gradient-warning btn-icon-split" data-bs-toggle="modal" data-bs-target="#ArchiveViewModal" data-url="/Admin/RestoreDeletedStudent/" data-title="Deleted Student's Details">
                <span class="text">Archive</span>
            </button>
        </div>    
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="selectAll"></th>
                        <th><strong>#</strong></th>
                        <th><strong>LRN No.</strong></th>
                        <th><strong>Full Name</strong></th>
                        <th><strong>Sex</strong></th>
                        <th><strong>Grade & Section</strong></th>
                        <th><strong>Action</strong></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach(var students in Model)
                    {
                        <tr>
                            <td><input type="checkbox" class="student-checkbox" data-student-id="@students.Id" data-current-grade="@students.SectionAssignments.FirstOrDefault()?.Section.Grade?.GradeLevel"></td>
                            <td><strong>@(i++)</strong></td>
                            <td><strong>@students.LRN</strong></td>
                            <td><strong>@students.LastName, @students.FirstName @students.MiddelName </strong></td>
                            <td><strong>@students.Sex</strong></td>
                            <td>
                                @if(students.SectionAssignments.FirstOrDefault() == null)
                                {
                                    <strong style="font-style: italic;">No classes assigned yet</strong>
                                }
                                else
                                {
                                     @if(@students.SectionAssignments.FirstOrDefault()?.Section?.Track == null)
                                    {
                                        <strong>
                                            Grade @students.SectionAssignments.FirstOrDefault()?.Section.Grade?.GradeLevel - 
                                            @students.SectionAssignments.FirstOrDefault()?.Section?.SectionName 
                                        </strong>
                                        
                                    }else if(@students.SectionAssignments.FirstOrDefault()?.Section?.TVLProgram == null)
                                    {
                                        <strong>
                                            Grade @students.SectionAssignments.FirstOrDefault()?.Section.Grade?.GradeLevel - 
                                            @students.SectionAssignments.FirstOrDefault()?.Section?.SectionName -
                                            @students.SectionAssignments.FirstOrDefault()?.Section?.Track 
                                        </strong>
                                    }
                                    else
                                    {
                                        <strong>
                                            Grade @students.SectionAssignments.FirstOrDefault()?.Section.Grade?.GradeLevel - 
                                            @students.SectionAssignments.FirstOrDefault()?.Section?.SectionName -
                                            @students.SectionAssignments.FirstOrDefault()?.Section?.Track -
                                            @students.SectionAssignments.FirstOrDefault()?.Section?.TVLProgram
                                        </strong>
                                    }    
                                }
                                            
                                </td>
                            <td>
                                @* <button data-id="@students.Id" type="button" class="btn btn-primary btn-circle" data-bs-toggle="modal" data-bs-target="#ViewModal" data-url="/Admin/ViewStudent/" data-title="View Student's Details">
                                    <i class="fas fa-eye"></i>
                                </button>

                                <button data-id="@students.Id" type="button" class="btn btn-primary btn-circle" data-bs-toggle="modal" data-bs-target="#EditModal" data-url="/Admin/EditStudent/" data-title="Edit Student's Details">
                                    <i class="fas fa-edit"></i>
                                </button>

                                <button data-id="@students.Id" type="button" class="btn btn-danger btn-circle delete-teacher-button" data-bs-toggle="modal" data-bs-target="#ModalDelete">
                                    <i class="fas fa-trash"></i>
                                </button>   *@
                                    
                                <div class="btn-group">
                                    <button type="button" class="btn btn-outline-info dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Action
                                    </button>
                                    <div class="dropdown-menu">
                                        <button data-id="@students.Id" type="button" class="btn btn-primary btn-circle dropdown-item" data-bs-toggle="modal" data-bs-target="#ViewModal" data-url="/Admin/ViewStudent/" data-title="View Student's Details" title="View Student">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        <button data-id="@students.Id" type="button" class="btn btn-primary btn-circle dropdown-item" data-bs-toggle="modal" data-bs-target="#EditModal" data-url="/Admin/EditStudent/" data-title="Edit Student's Details" title="Edit Student">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <button data-id="@students.Id" type="button" class="btn btn-danger btn-circle delete-teacher-button dropdown-item" data-bs-toggle="modal" data-bs-target="#ModalDelete" title="Delete Student">
                                            <i class="fas fa-trash"></i>
                                        </button>                                  
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    

                </tbody>
            </table>
        </div>
    </div>
</div>
