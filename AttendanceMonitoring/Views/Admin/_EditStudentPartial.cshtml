@using AttendanceMonitoring.ViewModel;
@model EditStudentViewModel; //for validation
@{
    ViewData["Title"] = "Edit Student";
}

<form id="EditStudentForm" asp-action="EditStudent" class="row g-3" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="col-12">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    </div>
    <div class="col-12">
        <label asp-for="SectionId" class="form-label"><strong>Grade & Section</strong></label>
        <select asp-for="SectionId" asp-items="@Model.AvailableGradeSection" id="sectionSelection" class="form-control gradeSectionSelection" required>
            <option value="">Select Grade and Section...</option>
        </select>
        <span asp-validation-for="AvailableGradeSection" class="text-danger validation-error-message"></span>
    </div>
    <div class="col-6">
        <label asp-for="LRN" class="form-label"><strong>LRN</strong></label>
        <input type="text" maxlength="12" oninput="this.value = this.value.replace(/[^0-9]/g, '')" asp-for="LRN" class="form-control" required />
        <span asp-validation-for="LRN" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Sex" class="form-label"><strong>Sex</strong></label>
        <select asp-for="Sex" class="form-control" required>
            <option value="" selected>Choose...</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
        </select>
        <span asp-validation-for="Sex" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="FirstName" class="form-label"><strong>First Name</strong></label>
        <input type="text" maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-ZÑñ\s\-']/g, '')" asp-for="FirstName" class="form-control" required />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MiddelName" class="form-label"><strong>Middle Name</strong></label>
        <input type="text" maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-ZÑñ\s\-']/g, '')" asp-for="MiddelName" class="form-control" />
        <span asp-validation-for="MiddelName" class="text-danger"></span>
    </div>
    <div class="col-6">
        <label asp-for="LastName" class="form-label"><strong>Last Name</strong></label>
        <input type="text" maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-ZÑñ\s\-']/g, '')" asp-for="LastName" class="form-control" required />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="col-6 form-group">
        <label asp-for="imageFile" class="form-label"><strong>Upload Image </strong>(Optional)</label>
        <div class="custom-file">
            <input asp-for="imageFile" class="custom-file-input">
            <label asp-for="imageFile" class="custom-file-label" for="imageFile">Choose file</label>
            <span asp-validation-for="imageFile" class="text-danger"></span>
        </div>
        <div class="form-group d-flex justify-content-center align-items-center mt-2">
            @if (string.IsNullOrEmpty(Model.imageFilePath as string))
            {
                <img src="~/DashboardTemplate/images/defaultImage.png" class="img-fluid img-thumbnail" style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%" id="imagePreview" alt="Image" />
            }
            else
            {
                <img src="~/ProfilePic/@Model.imageFilePath" class="img-fluid img-thumbnail" style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%" id="imagePreview" alt="Image" />
            }
        </div>
    </div>

    <div class="modal-footer col-12">
        <button type="submit" class="btn btn-primary" id="SaveStudent">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</form>
@section Script {
    @{

        await Html.RenderPartialAsync("_ValidationScriptPartial.cshtml");
    }
}