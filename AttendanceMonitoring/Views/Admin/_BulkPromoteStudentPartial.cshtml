@using AttendanceMonitoring.ViewModel;
@model BulkPromoteViewModel;
@{
    ViewData["Title"] = "Bulk Promote Students";
}

<form id="BulkPromoteStudentForm" asp-action="BulkPromoteStudent" class="row g-3" method="post">
    @Html.AntiForgeryToken()

    @for(int i = 0; i < Model.Students.Count; i++)
    {
        <input type="hidden" name="StudentIds[@i]" value="@Model.StudentIds[i]" />
    }

    <div class="col-12">
        <label asp-for="SectionId">Promote to Class:</label>
        <select id="sectionSelection" asp-for="SectionId" asp-items="Model.AvailableGradeSection" class="form-control mb-3" required>
            <option value="">Select Class..</option>
        </select>
    </div>
    <div class="col-12">
        <h5>Promote <span id="promoteCount">(@Model.StudentIds.Count)</span> Students</h5>
    </div>

    <div class="col-12 text-black">
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Selected students from: <br />
            @* <strong id="currentGrades">@Model.currentSections</strong> *@
            <ul class="mb-0 mt-2">
                @foreach(var sections in Model.currentSections)
                {
                    <li><strong>@sections</strong></li>
                }
            </ul>
        </div>
    </div>  
    
    <div class="modal-footer col-12">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-success" >
            <i class="bi bi-check-circle"></i> Promote All
        </button>
    </div>
</form>

@section Script {
    @{

        await Html.RenderPartialAsync("_ValidationScriptPartial.cshtml");
    }
}