@using System.Linq
@model IEnumerable<AttendanceMonitoring.Models.Grade> //always use IEnumerble when returning list on controller. And recommended when looping
<!--Put AttendanceMonitoring.Models in ViewImports so that it will not be repeated on all razor pages. So you can directly use 'atModel'-->
@{
    ViewData["Title"] = "Grade List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Teacher List-->
<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800">Grade List</h1>
<!-- <p class="mb-4">Table for Teachers Info</p> -->
<!-- DataTales Example -->
<div class="card shadow mb-2" style="margin-top: 20px;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">Table for Grade's Info</h6>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success bg-gradient-success btn-icon-split mr-1" data-bs-toggle="modal" data-bs-target="#AddSmallModalForm" data-url="/Admin/AddGrade" data-title="Add Grade Details">
                <span class="text">Add Grade</span>
            </button>
            <button type="button" class="btn btn-warning bg-gradient-warning btn-icon-split" data-bs-toggle="modal" data-bs-target="#ViewModal" data-url="/Admin/RestoreGrade/" data-title="Restore Grade Details">
                <span class="text">Archive</span>
            </button>
        </div>
        
    </div>
    <div class="card-body mb-2">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th><strong>#</strong></th>
                        <th><strong>Grade Level</strong></th>
                        <th><strong>Category</strong></th>
                        <th><strong>Action</strong></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach (var GradeLevel in Model)
                    {

                        <tr>
                            <td><strong>@(i++)</strong></td>
                            <td><strong>Grade @GradeLevel.GradeLevel</strong></td>
                            <td><strong>@GradeLevel.Category</strong></td>
                            <td class="text-center">
                                <strong>
                                    <button data-id="@GradeLevel.Id" type="button" class="btn btn-primary btn-circle" data-bs-toggle="modal" data-bs-target="#EditSmallModal" data-url="/Admin/EditGrade/" data-title="Edit Grade Detail's">
                                        <i class="fas fa-edit"></i>@*Edit*@
                                    </button>
                                    <button data-id="@GradeLevel.Id" type="button" class="btn btn-danger btn-circle" data-bs-toggle="modal" data-bs-target="#ModalDelete" >
                                        <i class="fas fa-trash"></i>@*Delete*@
                                    </button>
                                </strong>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
   
</div>

@section Scripts {
    <script src="~/js/admin-gradeandsection.js"></script>
}

