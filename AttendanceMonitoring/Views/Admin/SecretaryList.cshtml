@using System.Linq <!-- Para magamit Yung FirstOrDefault() methods sa loob ng razor -->

@* Para matype safely yung view IMPORTANT ALWAYS USE THIS FOR LIST/FOREACH*@
@model IEnumerable<AttendanceMonitoring.Models.AppUser>

@{
    ViewData["Title"] = "Secretary List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Teacher List-->
<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800">Secretary List</h1>
<!-- <p class="mb-4">Table for Teachers Info</p> -->
<!-- DataTales Example -->
<div class="card shadow mb-4" style="margin-top: 20px;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">Table for Secretary's Info</h6>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-success btn-icon-split" data-bs-toggle="modal" data-bs-target="#AddModalForm" data-url="/Admin/AddSecretary" data-title="Add Secretary's Details">
            <span class="text">Add Secretary</span>
        </button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th class="text-center"><strong>#</strong></th>
                        <th><strong>School ID</strong></th>
                        <th><strong>Full Name</strong></th>
                        <th><strong>Grade and Section</strong></th>                  
                        <th><strong>Sex</strong></th>
                        <th><strong>Action</strong></th>
                    </tr>
                </thead>
                <!-- <tfoot>
                    <tr>
                        <th>ID</th>
                        <th>First Name</th>
                        <th>Middle Name</th>
                        <th>Last Name</th>
                        <th>Sex</th>
                        <th>TTPS</th>
                    </tr>
                </tfoot> -->
                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach(var secretary in Model)
                    {
                        <tr>
                            <td class="text-center"><strong>@(i++)</strong></td>
                            <td><strong>@secretary.SchoolId</strong></td>
                            <td><strong>@secretary.LastName, @secretary.FirstName @secretary.MiddleName </strong></td>
                            <td><strong>@secretary.Sex</strong></td>

                            <td>
                                @if (@secretary.SecretariesAssignments.FirstOrDefault()?.Section?.Track == null)
                                {
                                    <strong>
                                        @secretary.SecretariesAssignments.FirstOrDefault()?.Section.Grade?.GradeLevel -
                                        @secretary.SecretariesAssignments.FirstOrDefault()?.Section?.SectionName
                                    </strong>
                                        
                                }else if(@secretary.SecretariesAssignments.FirstOrDefault()?.Section?.TVLProgram == null)
                                {
                                    <strong>
                                        @secretary.SecretariesAssignments.FirstOrDefault()?.Section.Grade?.GradeLevel -
                                        @secretary.SecretariesAssignments.FirstOrDefault()?.Section?.SectionName -
                                        @secretary.SecretariesAssignments.FirstOrDefault()?.Section?.Track
                                    </strong>
                                }
                                else
                                {
                                    <strong>
                                        @secretary.SecretariesAssignments.FirstOrDefault()?.Section.Grade?.GradeLevel -
                                        @secretary.SecretariesAssignments.FirstOrDefault()?.Section?.SectionName -
                                        @secretary.SecretariesAssignments.FirstOrDefault()?.Section?.Track -
                                        @secretary.SecretariesAssignments.FirstOrDefault()?.Section?.TVLProgram
                                    </strong>
                                }                 
                            </td>

                            <td class="text-center">
                                <button data-id="@secretary.Id" type="button" class="btn btn-primary btn-circle" data-bs-toggle="modal" data-bs-target="#ViewModal" data-url="/Admin/ViewSecretary/" data-title="View Secretary's Details">
                                    <i class="fas fa-eye"></i>@*View*@
                                </button>
                                <button data-id="@secretary.Id" type="button" class="btn btn-primary btn-circle" data-bs-toggle="modal" data-bs-target="#EditModal" data-url="/Admin/EditSecretary/" data-title="Edit Secretary Detail's">
                                    <i class="fas fa-edit"></i>@*Edit*@
                                </button>
                                <button data-id="@secretary.Id" type="button" class="btn btn-danger btn-circle" data-bs-toggle="modal" data-bs-target="#ModalDelete" >
                                    <i class="fas fa-trash"></i>@*Delete*@
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
 
@* Add Secretary modal
<div class="modal fade" id="AddSecretary" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel"><strong>Secretary's Details</strong></h5>
            </div>
            <div class="modal-body" id="AddSecretaryModal">
            </div>
        </div>
    </div>
</div> *@


@section Scripts {
    @* <script src="~/js/adminJs.js"></script> *@
    <script src="~/js/admin-secretary.js"></script>
    <script>
    </script>
}