@* @using AttendanceMonitoring.Models; *@
@using System.Linq
@model IEnumerable<AttendanceMonitoring.Models.Section>
@{
    ViewData["Title"] = "Restore Section";
}
<div class="card shadow mb-2" style="margin-top: 20px;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">Table for Deleted Grades</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable2" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th><strong>#</strong></th>
                        <th><strong>Grade Level</strong></th>
                        <th><strong>Section Name</strong></th>
                        <th><strong>Category</strong></th>
                        <th><strong>Action</strong></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var c = 1;
                    }
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var Section in Model)
                        {
                            <tr>
                                <td><strong>@(c++)</strong></td>
                                <td><strong>Grade @Section.Grade.GradeLevel</strong></td>
                                <td><strong>@Section.SectionName</strong></td>
                                <td>
                                    <strong>
                                        @if (Section.Grade.Category == "Junior High School(JHS)")
                                        {
                                            @Section.Grade.Category
                                        }
                                        else if (Section.Track == "TVL")
                                        {
                                            @($"{Section.Grade.Category} - {Section.Track} - {Section.TVLProgram} ")
                                        }
                                        else
                                        {
                                            @($"{Section.Grade.Category} - {Section.Track} ")
                                        }
                                    </strong>
                                </td>
                                <td class="text-center">
                                    <strong>
                                        <button data-section-id="@Section.Id" type="button" class="btn btn-warning btn-circle restore-btn" title="Restore Section">
                                            <i class="fas fa-trash-restore"></i>
                                        </button>
                                    </strong>
                                </td>
                            </tr>
                        }
                    }      
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Script {
    @{

        await Html.RenderPartialAsync("_ValidationScriptPartial.cshtml");
    }
}