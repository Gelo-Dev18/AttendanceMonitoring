@using AttendanceMonitoring.ViewModel;
@using System.Security.Claims
@model ManageAccountViewModel;
@{
    ViewData["Title"] = "Manage Account";
}

<style>
    .form-group {
        color: black;
    }
</style>

<form asp-action="ManageAccount" id="manageAccountForm" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" /> <!--Kailangan nito kapag query parameter lang gamit sa Controller para malaman if kaninong userId-->

    <div class="form-group">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    </div>
    <div class="form-group">
        <label asp-for="LRN" class="form-label"><strong>Id Number</strong></label>
        <input type="text" maxlength="12" oninput="this.value = this.value.replace(/[^0-9]/g, '')" asp-for="LRN" class="form-control" required />
        <span asp-validation-for="LRN" class="text-danger"></span>
    </div>

    @* <div class="form-group">
        <label asp-for="NewPassword" class="form-label"><strong>Password</strong></label>
        <div class="input-group-append" id="show_hide_password">
            <input asp-for="NewPassword" class="form-control" required type="password" />
            <div class="input-group-text">
                <span class="fas fa-lock"></span>
            </div>
        </div>
        <label class="text-danger" style="font-style: italic; font-size: 14px;">*Leave blank if you don't want to change the password</label>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div> *@

    <div class="form-group">
        <label asp-for="NewPassword" class="form-label"><strong>Password</strong></label>
        <div class="input-group position-relative">
            <input asp-for="NewPassword" class="form-control password-input" type="password" style="border-radius: 0.25rem;" />
            <button class="btn toggle-password-btn toggle-password" type="button">
                <span class="fas fa-eye"></span>
            </button>
        </div>
        <label class="text-danger" style="font-style: italic; font-size: 14px;">*Leave blank if you don't want to change the password</label>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FirstName" class="form-label"><strong>First Name</strong></label>
        <input type="text" maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-ZÑñ\s\-']/g, '')" asp-for="FirstName" class="form-control" required>
        <span asp-validation-for="FirstName" class="text-danger validation-error-message"></span>
    </div>
    <div class="form-group">
        <label asp-for="MiddleName" class="form-label"><strong>Middle Name</strong></label>
        <input type="text" maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-ZÑñ\s\-']/g, '')" asp-for="MiddleName" class="form-control">
        <span asp-validation-for="MiddleName" class="text-danger validation-error-message"></span>
    </div>
    <div class="form-group">
        <label asp-for="LastName" class="form-label"><strong>Last Name</strong></label>
        <input type="text" maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-ZÑñ\s\-']/g, '')" asp-for="LastName" class="form-control">
        <span asp-validation-for="LastName" class="text-danger validation-error-message"></span>
    </div>
    <div class="form-group">
        <label class="form-label"><strong>Upload Image </strong>(Optional)</label>
        <div class="custom-file">
            <input asp-for="imageFile" class="custom-file-input">
            <label asp-for="imageFile" class="custom-file-label" for="imageFile">Choose file</label>
            <span asp-validation-for="imageFile" class="text-danger"></span>
        </div>
        <div class="form-group d-flex justify-content-center align-items-center mt-2">
            @if (string.IsNullOrEmpty(Model.imageFilePath as string))
            {
                <img src="~/DashboardTemplate/images/defaultImage.png" class="img-fluid img-thumbnail" style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%" id="imagePreview" alt="Image" />
            }
            else
            {
                <img src="~/ProfilePic/@Model.imageFilePath" class="img-fluid img-thumbnail" style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%" id="imagePreview" alt="Image" />
            }
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary" id="SaveManageAccount">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</form>
@section Scripts {
    @{

        await Html.RenderPartialAsync("_ValidationScriptPartial.cshtml");
    }
}