@* @using AttendanceMonitoring.Models; *@
@using System.Linq
@model IEnumerable<AttendanceMonitoring.Models.AppUser>
@{
    ViewData["Title"] = "Restore Deleted Secretary";
}
<div class="card shadow mb-2" style="margin-top: 20px;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">Table for Deleted Secretary</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable2" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th class="text-center"><strong>#</strong></th>
                        <th><strong>LRN</strong></th>
                        <th><strong>Full name</strong></th>
                        <th><strong>Sex</strong></th>
                        <th><strong>Assigned Class</strong></th>
                        <th><strong>Period</strong></th>
                        <th><strong>Action</strong></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var c = 1;
                    }
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var secretary in Model)
                        {
                            var assignment = secretary.SecretariesAssignments?.FirstOrDefault();

                            <tr>
                                <td><strong>@(c++)</strong></td>
                                <td><strong>@secretary.SchoolId</strong></td>
                                <td><strong>@secretary.LastName, @secretary.FirstName @secretary.MiddleName</strong></td>
                                <td><strong>@secretary.Sex</strong></td>
                                <td>
                                    <strong>
                                        @if (assignment != null)
                                        {
                                            <text>
                                                Grade @assignment.Section?.Grade?.GradeLevel
                                                @assignment.Section?.SectionName
                                                @assignment.Section?.Track
                                                @assignment.Section?.TVLProgram
                                            </text>
                                        }
                                        else
                                        {
                                            <text>
                                                No class assigned!
                                            </text>
                                        }

                                    </strong>
                                </td>
                                <td>
                                    <strong>
                                        @assignment.CreatedAt.ToString("MMMM/dd/yyyy") to @assignment.DeletedAt?.ToString("MMMM/dd/yyyy")
                                    </strong>
                                </td>
                                <td class="text-center">
                                    <strong>
                                        <button data-secretary-id="@secretary.Id" type="button" class="btn btn-warning btn-circle restore-btn" title="Restore Secretary Assignment Details">
                                            <i class="fas fa-trash-restore"></i>
                                        </button>
                                    </strong>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Script {
    @{

        await Html.RenderPartialAsync("_ValidationScriptPartial.cshtml");
    }
}