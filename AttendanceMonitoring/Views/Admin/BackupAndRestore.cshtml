@using AttendanceMonitoring.Services
@using AttendanceMonitoring.ViewModel
@* @model List<BackupFileInfo> *@
@* @model PaginatedResult<BackupFileInfo> *@
@model BackupViewModel
@{
    ViewData["Title"] = "Backup and Restore";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .colorOfText{
        color: #2d3748;
    }
</style>
@* <div class="row">
    <div class="col-md-12">
        <h2>
            <i class="fas fa-database"></i> Database Backup and Restore Management
        </h2>
    </div>
</div> *@
@* <h1 class="h3 mb-2 text-gray-800 colorOfText"> *@
<h1 class="h3 mb-2 colorOfText">

    <i class="fas fa-database"></i> Database Backup and Restore Management
</h1>

@if(TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@TempData["SuccessMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>@TempData["ErrorMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<!-- Instructions Section -->
<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0 colorOfText">
            <i class="fas fa-question-circle"></i> Instructions
        </h5>
    </div>
    <div class="card-body">
        <ul class="colorOfText">
            <li><strong>Create Backup:</strong> Click "Create Backup Now" to generate a new database backup file.</li>
            <li><strong>Download:</strong> Click the "Download" button next to any backup to save it to your computer.</li>
            <li><strong>Storage:</strong> Backup files are stored securely on the server and cannot be accessed directly via URL.</li>
            <li><strong>Important:</strong> Store downloaded backups in a safe location. They contain sensitive data!</li>
        </ul>
    </div>
</div>
@*BACKUP DIV*@
<div class="card mb-4 border-success">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            <i class="fas fa-plus-circle"></i>Create New Backup
        </h5>
    </div>
    <div class="card-body">
        <p class="muted colorOfText">
            Click the button below to create a new database backup.
            This process may take a few minutes depending on database size.
        </p>
        <form asp-action="CreateBackup" method="post" onsubmit="return confirmBackup();">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary" id="backupButton">
                <i class="fas fa-save"></i>Create Backup Now         
            </button>
            <small class="text-muted d-block mt-2 colorOfText">
                <i class="fas fa-info-circle"></i> Backup files are stored securely on the server.
            </small>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">
            <i class="fas fa-list"></i> Existing Backups
        </h5>
    </div>

    <div class="card-body">
        @if (Model.PaginatedBackups.Result != null && Model.PaginatedBackups.Result.Any())
        {

            @* <div class="row">
                
            </div> *@
            <div class="table-responsive">
                <div class="mb-2 d-flex justify-content-end">
                    <form asp-action="BackupAndRestore" method="get">
                        <div class="input-group">
                            <input type="text" name="s" class="form-control" value="@Model.SearchKeyword"/>
                            <button type="submit" class="btn btn-success">search</button>
                        </div>
                    </form>
                </div>
                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>
                                <i class="fas fa-file"></i> File Name
                            </th>
                            <th>
                                <i class="fas fa-calendar"></i> Created Date
                            </th>
                            <th>
                                <i class="fas fa-hdd"></i> Size (MB)
                            </th>
                            <th class="text-center">
                                <i class="fas fa-cog"></i> Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach(var backup in Model.PaginatedBackups.Result)
                        {
                            <tr>
                                <td>
                                    <i class="fas fa-file-archive text-primary"></i>
                                    <strong>@backup.FileName</strong>
                                </td>
                                <td>
                                    @backup.CreatedDate.ToString("MMMM dd, yyyy hh:mm tt")
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        @backup.SizeMB MB
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="DownloadBackup"
                                        asp-route-fileName="@backup.FileName"
                                        class="btn btn-success"
                                        title="Download this backup">
                                        <i class="fas fa-download"></i>Download
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <nav>
                    <ul class="pagination justify-content-end">
                        <li class="page-item @(Model.PaginatedBackups.Page == 1 ? "disabled" : "")">
                            <a class="page-link" asp-route-p="@(Model.PaginatedBackups.Page - 1)">Previous</a>
                        </li>
                        @for (var pageNumber = 1; pageNumber <= Model.PaginatedBackups.TotalCount; pageNumber++)
                        {
                            if (pageNumber == Model.PaginatedBackups.Page)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@pageNumber</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-route-s="@Model.SearchKeyword" asp-route-p="@pageNumber">@pageNumber</a>
                                </li>
                            }
                        }
                        <li class="page-item @(Model.PaginatedBackups.Page == Model.PaginatedBackups.TotalCount ? "disabled" : "")">
                            <a class="page-link" asp-route-s="@Model.SearchKeyword" asp-route-p="@(Model.PaginatedBackups.Page + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>

            <div class="alert alert-info mt-3">
                <i class="fas fa-lightbulb"></i>
                <strong>Total Backups:</strong> @Model.PaginatedBackups.TotalCount backup file(s) available
            </div>
        }
        else
        {
            <div class="mb-2 d-flex justify-content-end">
                <form asp-action="BackupAndRestore" method="get">
                    <div class="input-group">
                        <input type="text" name="s" class="form-control" value="@Model.SearchKeyword" />
                        <button type="submit" class="btn btn-success">search</button>
                    </div>
                </form>
            </div>
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>No backups found.</strong> Create your first backup using the button above!
            </div>
        }
    </div>
</div>
@*RESTORE DIV*@

<div class="card mt-4 border-danger mb-4">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">
            <i class="fas fa-exclamation-triangle"></i>⚠️ DANGER ZONE: Database Restore
        </h5>
    </div>

    <div class="card-body">
        <div class="alert alert-danger">
            <h5><i class="fas fa-skull-crossbones"></i>WARNING!</h5>
            <p class="mb-0">
                <strong>Restoring a backup will:</strong>
            </p>
            <ul>
                <li>❌ DELETE all current data</li>
                <li>❌ REPLACE it with data from the selected backup</li>
                <li>❌ This action CANNOT BE UNDONE</li>
            </ul>
            <p class="mb-0">
                <strong>⚠️ Only restore if you are CERTAIN you want to lose all recent changes!</strong>
            </p>
            @* <br />
            <!-- TO BE IMPLEMENTED-->
            <div class="form-group">
                <div class="custom-file">
                    <input type="file" class="custom-file-input" id="restoreFile" accept=".bak">
                    <label class="custom-file-label" for="restoreFile">Choose file</label>
                </div>
            </div> *@
        </div>
        @if(Model.RecentBackupsForRestore != null && Model.RecentBackupsForRestore.Any())
        {
            <h6 class="mt-3">Select Backup to Restore:</h6>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Backup File</th>
                            <th>Date Created</th>
                            <th>Size</th>
                            <th class="text-center">Restore</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var backup in Model.RecentBackupsForRestore)
                        {
                            <tr>
                                <td>
                                    <i class="fas fa-file-archive text-danger"></i>
                                    @backup.FileName
                                </td>
                                <td>@backup.CreatedDate.ToString("MMMM dd, yyyy hh:mm tt")</td>
                                <td>
                                    <span class="badge bg-info">@backup.SizeMB MB</span>
                                </td>
                                <td class="text-center">
                                    <form asp-action="RestoreDatabase" method="post" onsubmit="return confirmRestore('@backup.FileName', '@backup.CreatedDate.ToString("MMMM dd, yyyy hh:mm tt")');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="backupFileName" value="@backup.FileName" />
                                            <button type="submit" class="btn btn-danger">
                                                <i class="fas fa-undo"></i>Restore
                                            </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                
            </div>
        }
        else
        {
            <p class="text-muted">No backups available to restore.</p>
        }
    </div>
</div>


@section Scripts
{
    <script src="~/js/admin-backupAndRestore.js"></script>

}

