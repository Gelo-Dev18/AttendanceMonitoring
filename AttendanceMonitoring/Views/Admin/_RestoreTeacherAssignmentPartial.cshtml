@* @using AttendanceMonitoring.Models; *@
@using System.Linq
@model IEnumerable<AttendanceMonitoring.Models.TeacherAssignment>

@{
    ViewData["Title"] = "Restore Teacher Assignments";
}

<div class="card shadow mb-2" style="margin-top: 20px;">
    @* <div class="card-header py-3 d-flex justify-content-between align-items-center"> *@
    <div class="card-header py-3 ">

        <h5 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">Table for Teacher Assignment's History</h5>

    </div>
    <div class="card-body">
        <h6 class="m-0 font-weight-bold mb-1"> Current Period: @ViewBag.Year : @ViewBag.Period Grading</h6>

        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable2" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th><strong>#</strong></th>
                        <th><strong>Teacher</strong></th>
                        <th><strong>Grade & Section</strong></th>
                        <th><strong>Subject Description</strong></th>
                        <th><strong>Status</strong></th>
                        <th><strong>Action</strong></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var c = 1;
                    }
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var sectionSubject in Model)
                        {
                            <tr>
                                <td><strong>@(c++)</strong></td>
                                <td><strong>@sectionSubject.Teacher?.FirstName @sectionSubject.Teacher.MiddleName @sectionSubject.Teacher.LastName</strong></td>

                                <td>
                                    <strong>
                                          Grade @sectionSubject.SectionSubject.Section.Grade.GradeLevel 
                                                @sectionSubject.SectionSubject.Section.SectionName 
                                                @sectionSubject.SectionSubject.Section.Track 
                                                @sectionSubject.SectionSubject.Section.TVLProgram 
                                    </strong>
                                </td>
                                @* <td><strong>@sectionSubject.SectionId</strong></td> *@
                                <td><strong>@sectionSubject.SectionSubject.Subject.SubjectDescription</strong></td>
                                <td>
                                    
                                    @if(sectionSubject.Teacher.IsDeleted == true)
                                    {
                                        <strong class="text-danger">⚠️Teacher Deleted</strong>
                                    }
                                    else
                                    {
                                        <strong class="text-success">Active</strong>
                                    }
                                </td>

                                <td class="text-center">
                                    <strong>
                                        @if (sectionSubject.Teacher.IsDeleted == true)
                                        {
                                            <button data-assignment-id="@sectionSubject.Id" type="button" class="btn btn-warning btn-circle restore-btn" title="Restore Teacher Assignment Details" disabled>
                                                <i class="fas fa-trash-restore"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button data-assignment-id="@sectionSubject.Id" type="button" class="btn btn-warning btn-circle restore-btn" title="Restore Teacher Assignment Details">
                                                <i class="fas fa-trash-restore"></i>
                                            </button>
                                        }

                                    </strong>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Script {
    @{

        await Html.RenderPartialAsync("_ValidationScriptPartial.cshtml");
    }
}