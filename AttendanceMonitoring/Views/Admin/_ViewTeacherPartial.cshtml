@using AttendanceMonitoring.ViewModel;
@model ViewTeacherViewModel;
@{
    ViewData["Title"] = "View Teacher";

}


@* <div class="card card-widget widget-user shadow" id="ViewTeacherModal"> *@
<div id="currentlyAssigned">
    <div class="card card-widget widget-user shadow">
        @Html.AntiForgeryToken() 
        <div class="widget-user-header bg-dark">
            <h3 class="widget-user-username">@Model.FirstName @Model.MiddleName @Model.LastName</h3>
            <h5 class="widget-user-desc">@Model.Email</h5>
        </div>
        <div class="widget-user-image">
            @* @if (Model.imageFile == null || Model.imageFile.Length > 0) *@
            @if(string.IsNullOrEmpty(Model.imageFilePath))
            {
                <h4 class="brand-image img-circle elevation-2 d-flex justify-content-center align-items-center bg-primary text-white font-weight-500" style="width: 110px;height: 110px">
                    @if (!string.IsNullOrEmpty(Model.FirstName) && !string.IsNullOrEmpty(Model.LastName))
                    {
                        @* <span>@Model.FirstName[0]</span> *@ @*Ginagamit kapag isang character lang ang need*@
                        <span>@(Model.FirstName.Substring(0, 1).ToUpper() + @Model.LastName.Substring(0, 1).ToUpper())</span> @*Gamitin kapag gusto display ang isang string at kapag need nag concatenation*@
                    }
                </h4>
            }
            else
            {
                <img class="img-circle elevation-2" src="/ProfilePic/@Model.imageFilePath" alt="User Avatar"
                        style="width: 120px;height: 120px;object-fit: cover">
            }

            @* <h4 class="brand-image img-circle elevation-2 d-flex justify-content-center align-items-center bg-primary text-white font-weight-500" style="width: 110px;height: 110px">
                BG
            </h4> *@
        </div>
        <div class="card-footer">
            <dl>
                <dt style="color: black">School ID</dt>
                <dd>@Model.SchoolId</dd>
            </dl>
            @* <div class="container-fluid"> *@
            @* <div class="card-body"> *@
                <b style="color: black">Assigned Subject</b>
                <div class="table-responsive">
                    <table class="table table-bordered" id="dataTable3" width="100%" cellspacing="0">
                        <thead>
                        <tr style="color: black">
                                <th>#</th>
                                <th>Grade and Section</th>
                                <th>Subject Description</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="assignedSubjectsList1">
                        @{
                            var c = 1;
                        }
                        @foreach (var teacherAssignment in Model.teacherAssignments)
                        {
                            <tr>
                                <td>@(c++)</td>
                                <td>Grade @teacherAssignment.SectionSubject.Section.Grade.GradeLevel @teacherAssignment.SectionSubject.Section.SectionName @teacherAssignment.SectionSubject.Section.Track @teacherAssignment.SectionSubject.Section.TVLProgram</td>

                                <td>@teacherAssignment.SectionSubject.Subject.SubjectDescription</td>



                                <td>
                                    <button class="btn btn-danger removebtn"
                                            data-assign-id="@teacherAssignment.Id" style="padding:5px">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            @* </div> *@
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</div>


@section Script {
    @{

        await Html.RenderPartialAsync("_ValidationScriptPartial.cshtml");
    }
}