@{
    ViewData["Title"] = "Grade and Section List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800">Grade and Section List</h1>
<!-- DataTales Example -->
<div class="card shadow mb-4" style="margin-top: 20px;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">Table for Grade and Section Info</h6>

        <!-- Button trigger modal -->
        <button type="button" class="btn btn-success btn-icon-split" data-bs-toggle="modal" data-bs-target="#AddSmallModalForm" data-url="/Admin/AddGradeAndSection" data-title="Add Grade & Section Details">
            <span class="text">Add Grade & Section</span>
        </button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th class="text-center"><strong>#</strong></th>
                        <th><strong>Grade Level</strong></th>
                        <th><strong>Section Name</strong></th>
                        <th><strong>Action</strong></th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach (var GradeAndSection in Model)
                    {
                        <tr>
                            <td><strong>@(i++)</strong></td>
                            <td><strong>@GradeAndSection.GradeLevel</strong></td>
                            <td><strong>@GradeAndSection.SectionName</strong></td>
                            <td class="text-center">
                                <strong>
                                    <button data-id="@GradeAndSection.Id" type="button" class="btn btn-primary btn-circle" data-bs-toggle="modal" data-bs-target="#EditSmallModal" data-url="/Admin/EditGradeAndSection/" data-title="Edit Grade and Section Details">
                                        <i class="fas fa-edit"></i>
                                    </button>

                                    <button data-id="@GradeAndSection.Id" type="button" class="btn btn-danger btn-circle delete-teacher-button" data-bs-toggle="modal" data-bs-target="#ModalDelete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </strong>
                            </td>

                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-gradeandsection.js"></script>
    <script>
    </script>
}

