@using AttendanceMonitoring.ViewModel.Teacher;
@model MySecretariesViewModel;
@{
    ViewData["Title"] = "Manage Secretary";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800">Manage Secretary List</h1>

<div class="card shadow mb-4" style="margin-top: 20px;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        @* @if (Model.Section.Track == null)
        {
            <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">
                Manage Students : Grade @Model.Section.Grade.GradeLevel - @Model.Section.SectionName, @Model.Subject?.SubjectDescription
            </h6>
        }
        else
        {
            <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">
                Manage Students : Grade @Model.Section.Grade @Model.Section.SectionName @Model.Section.Track @Model.Section.TVLProgram, @Model.Subject.SubjectDescription
            </h6>
        } *@
        <h6 class="m-0 font-weight-bold" style="color:rgb(21, 90, 27);">My Secretaries</h6>
        @* <a asp-controller="Teacher" asp-action="_MyClasses" class="btn btn-dark bg-gradient-dark">
            <span class="text">Class List</span>
        </a> *@
        <button type="button" class="btn btn-success bg-gradient-success btn-icon-split mr-1" data-bs-toggle="modal" data-bs-target="#AddModalForm" data-url="/Teacher/AddSecretary" data-title="Add Secretary's Details">
            <span class="text">Add Secretary</span>
        </button>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th><strong>#</strong></th>
                        <th><strong>LRN No.</strong></th>
                        <th><strong>Full Name</strong></th>
                        <th><strong>Sex</strong></th>
                        <th><strong>Secretaries Class</strong></th>
                        @* <th><strong>Subject</strong></th> *@

                        @* <th><strong>Action</strong></th> *@
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 1;
                    }
                    @foreach (var mySecretary in Model.Secretary)
                    {
                        <tr>
                            <td><strong>@(i++)</strong></td>
                            <td><strong>@mySecretary.Secretary.SchoolId</strong></td>
                            <td><strong>@mySecretary.Secretary.LastName, @mySecretary.Secretary.FirstName @mySecretary.Secretary?.MiddleName </strong></td>
                            <td><strong>@mySecretary.Secretary.Sex</strong></td>
                            <td><strong>Grade @mySecretary.Section.Grade.GradeLevel - @mySecretary.Section.SectionName @mySecretary.Section.Track @mySecretary.Section.TVLProgram</strong></td>
                            @* <td><strong>@mySecretary?.Section?.SectionSubjects.FirstOrDefault().Subject.SubjectDescription</strong></td> *@

                            @* <td class="text-center">
                                <button data-remove-id="@students.Id" type="button" class="btn btn-danger bg-gradient-danger remove-button" data-bs-toggle="modal" data-bs-target="#ModalDelete">
                                    Remove
                                </button>  
                            </td> *@
                        </tr>
                    }


                </tbody>
            </table>
        </div>
    </div>
</div>