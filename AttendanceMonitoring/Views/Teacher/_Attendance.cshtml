@using AttendanceMonitoring.ViewModel.Teacher;
@model AttendanceViewModel;
@{
    ViewData["Title"] = "Teacher Page";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}
<style>
    .list-group-item.active {
        background-color: #004943 !important; /* Bootstrap green */
        border-color: #004943 !important;
        color: white !important;
    }
    input[type="radio"]{
        transform: scale(1.5);

    }

    .form-check{
        padding-left: 29px!important;
    }
    /* Highlight row na may excuse reason */
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .student-row:hover {
        background-color: #f8f9fa;
    }

    .has-excuse {
        background-color: #e7f3ff !important;
    }

    .excuse-badge {
        font-size: 10px;
        padding: 2px 6px;
        margin-left: 5px;
    }   
</style>

<div class="col-lg-12" >
    <!-- FOR DEBUGGING-->
    @* <p>IsAttendanceStarted = @Model.IsStarted</p>
    <p>AcademicStatus = @Model.AcademicStatusId</p> *@
    @if (!Model.IsStarted)
    {
        <div class="card shadow mb-4 card-outline border-bottom-success card-body">
            The Attendance is not yet started or is closed.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-3">
                <div class="list-group" id="selectedValue">
                    @* DEBUG - DELETE LATER *@
                    @* <div style="background: yellow; padding: 10px; margin: 10px;">
                        <strong>DEBUG INFO:</strong><br />
                        teacherClass is null: @(Model.teacherClass == null)<br />
                        teacherClass count: @(Model.teacherClass?.Count ?? 0)<br />
                        IsAttendanceFinished: @Model.IsAttendanceFinished<br />
                    </div> *@
                    @if(Model.IsAttendanceFinished)
                    {
                    <div class="card shadow mb-4 card-outline border-bottom-success card-body">
                        You finished conducting Attendance
                    </div>
                    }
                    else if (Model.teacherClass != null && Model.teacherClass.Any())
                    {
                        @foreach (var teacherClass in Model.teacherClass)
                        {
                            //Dito na yung SelectedClass na galing sa controller. So kapag may selected na class, dun palang mag kakaroon ng Laman yung null na students(List<StudentSectionAssignment> students = null;)
                            var isActive = Model.SelectedClassId == teacherClass.SectionSubject.Id;

                            //Razor helper method : @Url.Action
                            // @Url.Action with href (Full Page Reload)
                            @* <a href="@Url.Action("_Attendance", "Teacher", new {selectedClassId = teacherClass.Id} )"
                            class="list-group-item list-group-item-action card shadow mb-4 card-outline border-bottom-success card-body @(isActive ? "active" : "")">
                            Grade @teacherClass.SectionSubject.Section.Grade.GradeLevel
                            @teacherClass.SectionSubject.Section.SectionName
                        </a> *@

                            //asp-action / asp-controller - Asp.Net Core -Tag Helpers = SAME THING FOR RAZOR HELPER METHOD TO FULL PAGE RELOAD, ONLY DIFFERENT SYNTAX
                            <a asp-action="_Attendance" asp-controller="Teacher" asp-route-selectedClassId="@teacherClass.SectionSubject.Id"
                               class="list-group-item list-group-item-action card shadow mb-4 card-outline border-bottom-success card-body @(isActive ? "active" : "")">
                                Grade @teacherClass.SectionSubject.Section.Grade.GradeLevel
                                @teacherClass.SectionSubject.Section.SectionName
                                @teacherClass.SectionSubject.Section.Track
                                @teacherClass.SectionSubject.Section.TVLProgram
                                @teacherClass.SectionSubject.Subject.SubjectDescription
                            </a>

                        }
                    }
                    else
                    {
                        <div class="list-group-item list-group-item-action">
                            <p><strong>No Assignments yet</strong></p>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-9">
                @* <div class="card shadow mb-4" style=""> *@

                <div class="card shadow mb-4 card-outline border-left-success">
                    <div class="card-header">
                        <b>Attendance for Academic Year: @Model.YearLevel - @Model.GradingPeriod Grading</b>
                        <!-- <div class="card-tools">
                            Submit Evaluation Button
                            <button class="btn btn-sm btn-flat btn-primary bg-gradient-primary mx-1 mt-2" form="manage-evaluation" id="submit-btn" disabled>Submit Evaluation</button>
                        </div> -->
                    </div>
                    <div class="card-body">

                        @if (Model.Students != null && Model.Students.Any())
                        {
                            <fieldset class="border border-success p-2 w-100">
                                <legend class="w-auto">Attendance Marking</legend>
                                <h4><strong>P</strong> = Present, <strong>A</strong> = Absent, <strong>L</strong> = Late, <strong>E</strong> = Excuse</h4>

                            </fieldset>
                            <form id="SaveAttendanceForm" method="post" asp-action="SaveAttendance" asp-controller="Teacher">
                                <input type="hidden" name="TeacherAssignmentId" value="@Model.TeacherAssignmentId">
                                @* <input type="hidden" name="" value=""/> *@
                                <input type="hidden" name="AcademicPeriodId" value="@Model.CurrentAcademicPeriodId">
                                <input type="hidden" name="SelectedClassId" value="@Model.SelectedClassId">
                                <input type="hidden" name="AttendanceDate" value="@DateTime.Now.ToString("MM/dd/yyyy hh:mm tt")">

                                <div class="clear-fix mt-2"></div>

                                <div class="table-responsive">
                                    <table class="table table-condensed">
                                        <thead>
                                            <tr class="bg-gradient-secondary" style="color: white;">
                                                <th class="p-1"><b>List of Students</b></th>
                                                <th class="text-center" style="font-size: 13px;">
                                                    <br>
                                                    P
                                                </th>
                                                <th class="text-center" style="font-size: 13px;">
                                                    <br>
                                                    A
                                                </th>
                                                <th class="text-center" style="font-size: 13px;">
                                                    <br>
                                                    L
                                                </th>
                                                <th class="text-center" style="font-size: 13px;">
                                                    <br>
                                                    C
                                                </th>
                                                <th class="text-center" style="font-size: 13px;">
                                                    <br>
                                                    E
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody class="tr-sortable">
                                            @* @{
                                            var attendanceOptions = new[]
                                            {
                                                new{Value = "Present", Label = "Present"},
                                                new{Value = "Late", Label = "Label"},
                                                new{Value = "Absent", Label = "Label"},
                                                new{Value = "Excuse", Label = "Excuse"}
                                            };
                                        } *@
                                            @foreach (var studentAssignment in Model.Students)
                                            {
                                                var studentId = studentAssignment.StudentId;
                                                var studentName = $"{studentAssignment.Student.FirstName} {studentAssignment.Student.MiddelName} {studentAssignment.Student.LastName}";

                                                <tr class="student-row" data-student-id="@studentId">
                                                    <td class="p-1">
                                                        @studentName
                                                        <span class="excuse-reason-display" style="display: none;"></span>
                                                        <input type="hidden" class="excuse-reason-input" name="ExcuseReason[@studentId]" value="">
                                                    </td>

                                                    @* <tr class="bg-white">
                                                    <td class="p-1" width="40%">
                                                        @studentAssignment.Student.FirstName
                                                        @studentAssignment.Student.MiddelName
                                                        @studentAssignment.Student.LastName
                                                        <input type="hidden" name="" value="">
                                                    </td> *@



                                                    @*//Dating foreach*@

                                                    @*----------FOR PRESENT----------*@

                                                    <td class="text-center" style="">
                                                        @* <div class="icheck-success d-inline"> *@
                                                        <div class="form-check">
                                                            <input class="form-check-input attendance-radio"
                                                                   type="radio"
                                                                   name="StudentAttendance[@studentId]" @*This create a dictionary: StudentAttendance["STU001"] = "Present"*@
                                                                   id="present_@studentId"
                                                                   value="Present" @*VALUE*@
                                                                   data-student-id="@studentId" />
                                                            <label class="form-check-label"
                                                                   for="present_@studentId">
                                                            </label>
                                                        </div>
                                                    </td>

                                                    @*----------FOR ABSENT----------*@


                                                    <td class="text-center" style="">
                                                        @* <div class="icheck-success d-inline"> *@
                                                        <div class="form-check">
                                                            <input class="form-check-input attendance-radio"
                                                                   type="radio"
                                                                   name="StudentAttendance[@studentId]" @*This create a dictionary: StudentAttendance["STU001"] = "Present"*@
                                                                   id="absent_@studentId"
                                                                   value="Absent"
                                                                   data-student-id="@studentId" />
                                                            <label class="form-check-label"
                                                                   for="absent_@studentId">
                                                            </label>
                                                        </div>
                                                    </td>

                                                    @*----------FOR LATE----------*@

                                                    <td class="text-center" style="">
                                                        @* <div class="icheck-success d-inline"> *@
                                                        <div class="form-check">
                                                            <input class="form-check-input attendance-radio"
                                                                   type="radio"
                                                                   name="StudentAttendance[@studentId]" @*This create a dictionary: StudentAttendance["STU001"] = "Present"*@
                                                                   id="late_@studentId"
                                                                   value="Late"
                                                                   data-student-id="@studentId" />
                                                            <label class="form-check-label"
                                                                   for="late_@studentId">
                                                            </label>
                                                        </div>
                                                    </td>

                                                    @*----------FOR LATE----------*@

                                                    <td class="text-center" style="">
                                                        @* <div class="icheck-success d-inline"> *@
                                                        <div class="form-check">
                                                            <input class="form-check-input attendance-radio"
                                                                   type="radio"
                                                                   name="StudentAttendance[@studentId]" @*This create a dictionary: StudentAttendance["STU001"] = "Present"*@
                                                                   id="cutting_@studentId"
                                                                   value="Cutting"
                                                                   data-student-id="@studentId" />
                                                            <label class="form-check-label"
                                                                   for="cutting_@studentId">
                                                            </label>
                                                        </div>
                                                    </td>
                                                    @*----------FOR EXCUSE----------*@

                                                    <td class="text-center" style="">
                                                        @* <div class="icheck-success d-inline"> *@
                                                        <div class="form-check">
                                                            <input class="form-check-input excuse-radio"
                                                                   @* <input class="form-check-input excuse-radio" data-bs-toggle="modal" data-bs-target="#excuseModal" *@
                                                                   type="radio"
                                                                   name="StudentAttendance[@studentId]" @*This create a dictionary: StudentAttendance["STU001"] = "Present"*@
                                                                   id="excuse_@studentId"
                                                                   value="Excuse"
                                                                   data-student-id="@studentId"
                                                                   data-student-name="@studentName" />
                                                            <label class="form-check-label"
                                                                   for="excuse_@studentId">
                                                            </label>
                                                            @* <input type="hidden"
                                                                   name="ExcuseReason[@studentId]"
                                                                   class="excuse-reason-input"
                                                                   value="" />
                                                            <!-- Visual indicator ng reason -->
                                                            <div class="excuse-reason-display" style="display: none;"></div> *@
                                                        </div>
                                                    </td>

                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                                <!-- Add a comment box for evaluators -->
                                <div class="form-group">
                                    <label for="Remarks"><strong>Remarks(Optional) </strong></label>
                                    <textarea name="Remarks" id="remarks" class="form-control" rows="4" placeholder="Enter any remarks here..."></textarea>

                                    <div class="card-tools" style="text-align: right;">
                                        <!-- Submit Evaluation Button -->
                                        <button class="btn btn-sm btn-flat btn-success bg-gradient-success mx-1 mt-2" id="submitBtn" disabled>Submit Attendance</button>
                                    </div>
                                </div>

                            </form>
                        }
                        else if (Model.SelectedClassId.HasValue)
                        {
                            <h3 class="text-center">
                                No Students assigned to this section yet
                            </h3>
                        }
                        else
                        {
                            @* <div class="list-group-item list-group-item-action shadow mb-4 card-outline border-bottom-success card-body">
                            Please Select Class to conduct Attendance
                        </div> *@
                            <h3 class="text-center">
                                Please select class to conduct Attendance
                            </h3>
                        }
                    </div>
                </div>
            </div>
        </div>
    }  
    
</div>

<!-- Excuse Reason Modal -->
<div class="modal fade" id="excuseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Excuse Reason</h5>
                @* <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button> *@
            </div>
            <div class="modal-body">
                <p class="mb-2">Student: <strong id="modalStudentName"></strong></p>
                <div class="form-group">
                    <label for="modalExcuseReason">Reason for Excuse <span class="text-danger">*</span></label>
                    <textarea for="ExcuseReason" id="modalExcuseReason" class="form-control" rows="4"
                              placeholder="Enter reason for excuse..." required></textarea>
                    @* <span asp-validation-for="ExcuseReason" class="text-danger validation-error-message"></span> *@

                    <small class="form-text text-muted">Please provide a valid reason.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveExcuseBtn">Save Reason</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/teacher-attendance.js"></script>
}
