
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Custom fonts for this template-->
    <link href="~/DashboardTemplate/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">
    <!-- Custom styles for this template-->
    <!-- <link href="../css/sb-admin-2.min.css" rel="stylesheet"> -->
    <link href="~/DashboardTemplate/css/sb-admin-2.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/AdminCss.css" rel="stylesheet">
    <link href="~/DashboardTemplate/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">

    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/custom-widget.css" rel="stylesheet" />
    <link href="~/DashboardTemplate/img/MCAPS.png" rel="icon" type="image/png" asp-append-version="true" />
    <link rel="stylesheet" href="~/select2Plugin/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/select2Plugin/dist/css/select2-bootstrap4.min.css" />

    <link rel="stylesheet" href="~/select2Plugin/dist/css/flatpickr.min.css" />


</head>
<body>
    <div id="blurred-overlay" class="blurred"></div>
    <div id="blurred-overlay-page" class="blurred"></div>

    <div id="wrapper">
        <!-- Sidebar -->
        <partial name="_AdminSidebar" />
        <div id="content-wrapper" class="d-flex flex-column">
            <!-- Main Content -->
            <div id="content">
                <!-- Navbar -->
                <partial name="_AdminNavbar"/>
                <!-- Begin Page Content -->
                <div class="container-fluid">
                    @RenderBody()                
                </div>
            </div>
            <!-- Footer -->
            <partial name="_Footer" />
        </div>
    </div>
    @*Alert Toast*@                                     @*z-index for layering*@
    <div style="position: fixed; top: 20px; right: 20px; z-index: 1090; font-size: 16px;">
        <div id="successToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" data-delay="1000">
            @* <div class="toast-header bg-success text-white">  *@
            @*     <strong class="mr-auto">Deleted!</strong>  *@
            @*     <small>Just now</small>  *@
            @* </div>  *@
            <div class="toast-body bg-success text-white" style="font-size: 16px; font-weight:600;">
                <i class="bi bi-check-circle-fill"></i>
                @* <span id="toast-message"><strong class="mr-auto" id="toast-body"></strong></span> *@
                <span id="toast-message"></span>
            </div>
        </div>
    </div>

    @*Update Success Toast*@
    <div style="position: fixed; top: 20px; right: 20px; z-index: 1090; font-size: 16px;">
        <div id="updateSuccessToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" data-delay="1000" >
            <div class="toast-body bg-success text-white" style="font-size: 16px; font-weight:600;">
                <i class="bi bi-check-circle-fill"></i>
                <span id="update-toast-message"></span>
            </div>
        </div>
    </div>

    @*Danger Toast*@
    <div style="position: fixed; top: 20px; right: 20px; z-index: 1090; font-size: 16px;">
        <div id="dangerToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true" data-delay="1000">
            <div class="toast-body bg-danger text-white" style="font-size: 16px; font-weight:600;">
                <i class="bi bi-x-circle-fill"></i>
                @* <strong class="mr-auto" id="#toast-body">Something went wrong. Please try again.</strong> *@
                <span id="dangertoast-message"></span>
            </div>
        </div>
    </div>

    @*Spinner*@
    <div id="spinnerWrapper" class="d-none" style="position: fixed; top: 0; right: 0; width: 100%; height: 100%; z-index: 1090; font-size: 16px; display: flex; justify-content: center; align-items: center;">
        <div id="spinnerLoad" class="spinner-border text-success" style="width: 3rem; height: 3rem;" role="status">
            @* <span class="visually-hidden">Loading...</span> *@
            <span class="sr-only">Loading...</span> 
        </div>
    </div>

    @*Add modal*@
    <div class="modal fade" id="AddModalForm" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="AddModalFormLabel">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="AddModalFormLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="AddModalFormBody">
                </div>
            </div>
        </div>
    </div>

    @*Add modal small*@
    <div class="modal fade" id="AddSmallModalForm" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="AddSmallModalFormLabel">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="AddSmallModalFormLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="AddSmallModalFormBody">
                </div>
            </div>
        </div>
    </div>

    @*Manage Account*@
    <div class="modal fade" id="ManageAccountModalForm" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="ManageAccountModalFormLabel">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ManageAccountModalFormLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="ManageAccountModalFormBody">
                </div>
            </div>
        </div>
    </div>

    @*Assign modal small*@
    <div class="modal fade" id="AssignForm" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="AssignFormLabel">
        <div class="modal-dialog modal-dialog-scrollable    ">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="AssignFormLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="AssignFormBody">
                </div>
            </div>
        </div>
    </div>

    @*Edit USer modal*@
    <div class="modal fade" id="EditModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="EditModalLabel">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg ">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="EditModalLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="EditModalBody">
                </div>
            </div>
        </div>
    </div>

    @*Assign Modal*@
    <div class="modal fade" id="AssignModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="AssignModalLabel">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl ">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="AssignModalLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="AssignModalBody">
                </div>
            </div>
        </div>
    </div>

    @*Self Assign Modal*@
    <div class="modal fade" id="SelfAssignModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="SelfAssignModalLabel">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl ">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="SelfAssignModalLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="SelfAssignModalBody">
                </div>
            </div>
        </div>
    </div>

    @*View Assign Modal*@
    <div class="modal fade" id="ViewAssignModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="ViewAssignModalLabel">
        <div class="modal-dialog modal-dialog-scrollable modal-xl ">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ViewAssignModalLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="ViewAssignModalBody">
                </div>
            </div>
        </div>
    </div>

    @*Edit USer small modal*@
    <div class="modal fade" id="EditSmallModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="EditModalLabel">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="EditSmallModalLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="EditSmallModalBody">
                </div>
            </div>
        </div>
    </div>

    @*View/Manage Modal*@
    <div class="modal fade" id="ViewModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="ViewModalBody">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ViewModalLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="ViewModalBody">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    
    @*View small Modal*@
    <div class="modal fade" id="ViewSmallModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="ViewSmallModalBody">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ViewSmallModalLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="ViewSmallModalBody">
                </div>
                @* <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div> *@
            </div>
        </div>
    </div>

    @*Promote Modal*@
    <div class="modal fade" id="PromoteModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="PromoteModalBody">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="PromoteModalLabel"><strong>...</strong></h5>
                </div>
                <div class="modal-body" id="PromoteModalBody">
                </div>
                @* <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div> *@
            </div>
        </div>
    </div>
    @* <!-- Delete Confirmation Modal --> *@
    <div class="modal fade" id="ModalDelete" data-bs-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel">
        <div class="modal-dialog">
            @* <div class="modal-dialog modal-dialog-centered"> *@
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center" id="staticBackdropLabel"><strong>Confirmation</strong></h5>
                </div>
                <div class="modal-body">
                    Are you sure you want to Delete ?
                </div>
                <div class="modal-footer">
                    <button id="confirmDeleteButton" class="btn btn-danger delete-teacher-button">
                        Delete
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* <!-- System Default Modal --> *@
    <div class="modal fade" id="ModalDefault" data-bs-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel">
        <div class="modal-dialog">
            @* <div class="modal-dialog modal-dialog-centered"> *@
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-center" id="staticBackdropLabel"><strong>Confirmation</strong></h5>
                </div>
                <div class="modal-body">
                    Are you sure to make this academic period as the system default?
                </div>
                <div class="modal-footer">
                    <button id="ConfirmDefaultButton" class="btn btn-primary default-academic-button">
                        Confirm
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        No
                    </button>
                </div>
            </div>
        </div>
    </div>

    


    <script src="~/DashboardTemplate/vendor/jquery/jquery.min.js"></script>
    <script src="~/DashboardTemplate/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="~/DashboardTemplate/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="~/DashboardTemplate/js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="~/DashboardTemplate/vendor/chart.js/Chart.min.js"></script>
    <script src="~/DashboardTemplate/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/DashboardTemplate/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="~/DashboardTemplate/js/demo/chart-area-demo.js"></script>
    <script src="~/DashboardTemplate/js/demo/chart-pie-demo.js"></script>
    <script src="~/DashboardTemplate/js/demo/datatables-demo.js"></script>
  
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* <script src="~/lib/jquery/dist/jquery.min.js"></script> @*For Ajax*@ 

    <!-- Select2 Plugin script -->
    <script src="~/select2Plugin/dist/js/select2.min.js"></script>
    <script src="~/select2Plugin/dist/js/flatpickr.min.js"></script>

    <script src="~/js/site.js"></script>
    <script src="~/js/admin-manageAccount.js"></script>


    <script src="~/lib/bootstrap-show-password.js"></script>
    @* <script src="~/lib/bootstrap-show-password.min.js"></script> *@


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>