@{
}
<form id="manageAccount" asp-action="" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    </div>
    <div class="form-group">
        <label  class="form-label"><strong>School Id</strong></label>
        <input  class="form-control" required />
        <span  class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="form-label"><strong>Password</strong></label>
        <input class="form-control" required />
        <span class="text-danger"></span>
    </div>
    
    <div class="form-group">
        <label class="form-label"><strong>First Name</strong></label>
        <input class="form-control"required>
        <span class="text-danger validation-error-message"></span>
    </div>
    <div class="form-group">
        <label class="form-label"><strong>Middle Name</strong></label>
        <input  class="form-control">
        <span class="text-danger validation-error-message"></span>
    </div>
    <div class="form-group">
        <label class="form-label"><strong>Last Name</strong></label>
        <input class="form-control">
        <span class="text-danger validation-error-message"></span>
    </div>
    <div class="col-6 form-group">
        <label class="form-label"><strong>Upload Image </strong>(Optional)</label>
        <div class="custom-file">
            <input class="custom-file-input">
            <label class="custom-file-label" for="imageFile">Choose file</label>
            <span class="text-danger"></span>
        </div>
        <div class="form-group d-flex justify-content-center align-items-center mt-2">
            <img src="~/DashboardTemplate/images/defaultImage.png" class="img-fluid img-thumbnail" style="width: 120px; height: 120px; object-fit: cover; border-radius: 50%" id="imagePreview" alt="Image" />
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary" id="SaveManageAccount">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</form>
