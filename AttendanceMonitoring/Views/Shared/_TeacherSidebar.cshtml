@{
    var isUserSectionActive = Html.IsActive("Teacher", "TeacherList", "StudentList", "SecretaryList") == "active";
    var isGradeAndSectionActive = Html.IsActive("Teacher", "GradeList", "SectionList") == "active";
}
<!-- Sidebar -->
<ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

    <!-- Sidebar - Brand -->
    <a class="sidebar-brand d-flex align-items-center justify-content-center " href="@Url.Action("TeacherHome", "Teacher")">
        <div class="sidebar-brand-icon">
            <!-- <i class="fas fa-laugh-wink"></i> -->
            <i class="fas fa-home"></i>
        </div>
        <div class="sidebar-brand-text mx-3">Teacher Dashboard</div>
    </a>

    <!-- Divider -->
    <hr class="sidebar-divider my-0">
    <!-- Nav Item - Dashboard -->
    @*Url.Action and Html.ActionLink(IsACtive) are helper method*@
    <li class="nav-item  @Html.IsActive("Teacher", "TeacherHome")">
        @*Dito nauna ang Controller name bago action name depende sa pag set mo sa custom method mo na IsActive*@
        <a class="nav-link" href="@Url.Action("TeacherHome", "Teacher")">
            @*Action name muna bago controllername kapag Url.Action ang gamit, default to*@
            <i class="fas fa-fw fa-tachometer-alt"></i>
            <span>Dashboard</span>
        </a>
    </li>

    <!-- Divider -->
    <hr class="sidebar-divider">

    <!-- Heading -->
    <div class="sidebar-heading">
        Interface
    </div>

    <!-- Nav Item - Conduct Attendance -->
    <li class="nav-item @Html.IsActive("Teacher", "_Attendance")">
        <a class="nav-link" href="@Url.Action("_Attendance", "Teacher")">
            <i class="fa fa-book">‌</i>
            <span>Attendance</span>
        </a>
    </li>


    <!-- Nav Item - Grade And Section -->
    <li class="nav-item @(isGradeAndSectionActive ? "active" : "")">
        <a class="nav-link collapsed @(isGradeAndSectionActive ? "active" : "")" href="#" data-toggle="collapse" data-target="#collapseTwo01"
           aria-expanded="true" aria-controls="collapseTwo">
            <i class="fas fa-chalkboard-teacher"></i>
            <span>Academic Classes</span>
        </a>
        <div id="collapseTwo01" class="collapse @(isGradeAndSectionActive ? "show" : "")" aria-labelledby="headingTwo" data-parent="#accordionSidebar">
            <div class="bg-white py-2 collapse-inner rounded">
                <h6 class="collapse-header">Class Components:</h6>
                <a class="collapse-item @Html.IsActive("Teacher", "GradeList")" href="@Url.Action("GradeList", "Teacher")">Grade List</a>
                <a class="collapse-item @Html.IsActive("Teacher", "SectionList")" href="@Url.Action("SectionList", "Teacher")">Section List</a>
            </div>
        </div>
    </li>

    <!-- Nav Item - Subjects -->
    <li class="nav-item @Html.IsActive("Teacher", "SubjectList")">
        <a class="nav-link" href="@Url.Action("SubjectList", "Teacher")">
            <i class="fa fa-book">‌</i>
            <span>Subjects</span>
        </a>
    </li>

    <!-- Nav Item - USERS -->
    <li class="nav-item @(isUserSectionActive ? "active" : "")">
        <a class="nav-link collapsed @(isUserSectionActive ? "active" : "")" href="#" data-toggle="collapse" data-target="#collapseTwo"
           aria-expanded="true" aria-controls="collapseTwo">
            <i class="fas fa-users"></i>
            <span>User List</span>
        </a>
        <div id="collapseTwo" class="collapse @(isUserSectionActive ? "show" : "")" aria-labelledby="headingTwo" data-parent="#accordionSidebar">
            <div class="bg-white py-2 collapse-inner rounded">
                <h6 class="collapse-header">User Components:</h6>
                <a class="collapse-item @Html.IsActive("Admin", "StudentList")" href="@Url.Action("StudentList", "Admin")">Student List</a>
                <a class="collapse-item @Html.IsActive("Admin", "SecretaryList")" href="@Url.Action("SecretaryList", "Admin")">Secretary List</a>
            </div>
        </div>
    </li>

    <!-- Nav Item - REPORTS -->
    <li class="nav-item">
        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseUtilities"
           aria-expanded="true" aria-controls="collapseUtilities">
            <i class="fas fa-fw fa-chart-area"></i>
            <span>Reports</span>
        </a>
        <div id="collapseUtilities" class="collapse" aria-labelledby="headingUtilities"
             data-parent="#accordionSidebar">
            <div class="bg-white py-2 collapse-inner rounded">
                <h6 class="collapse-header">Report Components:</h6>
                <a class="collapse-item" href="#">Record Lists</a>
                <a class="collapse-item" href="#">Attendace Records</a>
            </div>
        </div>
    </li>

    <!-- Divider -->
    <hr class="sidebar-divider">

    <!-- Heading -->
    <div class="sidebar-heading">
        System Settings
    </div>

    <!-- Divider -->
    <hr class="sidebar-divider d-none d-md-block">

    <!-- Sidebar Toggler (Sidebar) -->
    <div class="text-center d-none d-md-inline">
        <button class="rounded-circle border-0" id="sidebarToggle"></button>
    </div>
</ul>
